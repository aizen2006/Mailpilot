# Database
DATABASE_URL=postgresql://...

# Google OAuth (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# After OAuth, redirect browser here (use your web app origin + path)
# Example when Next.js runs on port 3001:
OAUTH_SUCCESS_URL=http://localhost:3001/connect/gmail/done

# Supabase — URL + anon for optional client-style calls
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Required for POST /user/sync-supabase (verify JWT)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (billing portal + webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=http://localhost:3001/dashboard/billing

# Legacy names (still supported by apps/backend/src/libs/supabase.ts)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
